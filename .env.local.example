# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored so secrets never reach the repo.

# --- Anthropic (Claude) ---
# Get a key at https://console.anthropic.com/settings/keys
# Cost lever: this is the LLM bill.
ANTHROPIC_API_KEY=sk-ant-...

# --- Voyage AI (embeddings) ---
# Get a key at https://www.voyageai.com/
# Free tier covers 200M tokens — plenty for portfolio phase.
VOYAGE_API_KEY=pa-...

# --- Supabase (database + vectors + auth + storage) ---
# Create a project at https://supabase.com — pick a free-tier project in any region.
# Settings -> API gives you the URL and the two keys below.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# Server-only key (used for privileged ops like ingestion). Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
