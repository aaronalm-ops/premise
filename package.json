{
  "name": "premise",
  "version": "0.0.1",
  "private": true,
  "description": "Premise — AI co-pilot for market and consumer insights researchers. Brief -> hypotheses -> questionnaire -> analysis -> story angles, grounded in your historical research via strict-mode RAG.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "ingest": "tsx --env-file=.env.local scripts/ingest.ts",
    "create-project": "tsx --env-file=.env.local scripts/create-project.ts",
    "diagnose": "tsx --env-file=.env.local scripts/diagnose.ts",
    "seed-public-library": "tsx --env-file=.env.local scripts/seed-public-library.ts",
    "seed-public-corpus": "tsx --env-file=.env.local scripts/seed-public-corpus.ts",
    "audit-public-corpus": "tsx --env-file=.env.local scripts/audit-public-corpus.ts",
    "audit-public-corpus-regions": "tsx --env-file=.env.local scripts/audit-public-corpus-regions.ts",
    "eval": "tsx --env-file=.env.local evals/cli.ts",
    "eval:setup": "tsx --env-file=.env.local evals/cli.ts --setup-only",
    "eval:reset": "tsx --env-file=.env.local evals/cli.ts --reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@mozilla/readability": "^0.5.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.50.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "jsdom": "^25.0.1",
    "mammoth": "^1.8.0",
    "next": "^15.5.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
